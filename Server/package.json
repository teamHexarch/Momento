{
  "name": "momento-server",
  "version": "2.9.0",
  "private": true,
  "type": "module",
  "description": "Momento API: accounts (email, Google, email confirmation), albums, join codes and photo uploads.",
  "main": "src/server.js",
  "scripts": {
    "test:moderation": "node scripts/testUploadChecks.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test:guest": "node scripts/testGuest.js",
    "test:groups": "node scripts/testGroups.js",
    "test:photos": "node scripts/testPhotos.js",
    "test:cover": "node scripts/testCover.js",
    "test:notify": "node scripts/testNotify.js",
    "test:jobs": "node scripts/testJobs.js",
    "test:storage": "node scripts/testStorage.js",
    "test:events": "node scripts/testEvents.js",
    "test:flows": "node scripts/testFlows.js",
    "test:privacy": "node scripts/testPhotoPrivacy.js",
    "test:nsfw": "node scripts/testNsfw.js",
    "test:security": "node scripts/testSecurity.js",
    "test:admin": "node scripts/testAdminTeam.js",
    "test:devices": "node scripts/testDevices.js",
    "test:comments": "node scripts/testComments.js",
    "test:uploads": "node scripts/testUploads.js",
    "test:venue": "node scripts/testVenue.js",
    "test:games": "node scripts/testGames.js",
    "test:winners": "node scripts/testGameWinners.js",
    "preview:review": "node scripts/reviewPreview.js",
    "admin-team": "node --env-file-if-exists=.env scripts/adminTeam.js",
    "test:attack": "node scripts/testAttack.js",
    "test:e2e": "playwright test -c tests/e2e",
    "test:e2e:watch": "playwright test -c tests/e2e --headed",
    "clean:old-data": "node --env-file=.env scripts/cleanOldData.js",
    "test": "node scripts/testGuest.js && node scripts/testGroups.js && node scripts/testPhotos.js && node scripts/testCover.js && node scripts/testNotify.js && node scripts/testJobs.js && node scripts/testStorage.js && node scripts/testEvents.js && node scripts/testFlows.js && node scripts/testPhotoPrivacy.js && node scripts/testNsfw.js && node scripts/testSecurity.js && node scripts/testAdminTeam.js && node scripts/testRekognition.js && node scripts/testDevices.js && node scripts/testComments.js && node scripts/testUploads.js && node scripts/testVenue.js && node scripts/testGames.js && node scripts/testAttack.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1177.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/client-sesv2": "^3.1164.0",
    "@aws-sdk/cloudfront-signer": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "buffer": "^6.0.3",
    "cookie-parser": "^1.4.7",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "google-auth-library": "^11.3.2",
    "heic-decode": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "mongodb-memory-server": "^11.3.0"
  }
}
