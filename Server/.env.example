# Momento server settings: a template. Copy to .env (never commit .env) and fill in.
# On the Lightsail server the real values live in /opt/momento-config/server.env.
# Every value below is a placeholder. Lines starting with # are optional.

# ---- Required ----
# The database (MongoDB Atlas). For local work, leave it out and run: node scripts/devMemory.js
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/momento?retryWrites=true&w=majority
# Signs logins. At least 32 random characters (production refuses less): openssl rand -base64 48
JWT_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-STRING

# ---- Addresses ----
PORT=4000
# Where this API is reached, and where people open the site
PUBLIC_URL=http://localhost:4000
# FRONTEND_URL=https://hexarch.org
# Sites allowed to call the API with the login cookie (comma-separated). Default: FRONTEND_URL (+ localhost:3000 outside production)
# CORS_ORIGINS=https://hexarch.org,https://www.hexarch.org
# EMAIL_VERIFICATION_BASE_URL=https://api.hexarch.org
# Proxies in front of the server (Caddy on Lightsail = 1)
# TRUST_PROXY=1

# ---- Photos ----
# Amazon S3 bucket for photos; leave empty to keep them on this machine's disk (local work only)
# S3_BUCKET=
# UPLOAD_DIR=uploads
# AWS_REGION=ap-southeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional CloudFront in front of the bucket (all three, or none)
# CLOUDFRONT_DOMAIN=
# CLOUDFRONT_KEY_PAIR_ID=
# CLOUDFRONT_PRIVATE_KEY=
# Limits: per photo (MB), per camera RAW file (MB), upload memory for the whole server and per account (MB)
# MAX_UPLOAD_MB=50
# Biggest photo read, in megapixels (100), and biggest iPhone/Samsung HEIC (60; it is decoded whole, about
# 4 MB a megapixel). On a 4 GB server, 210 for both takes 200 MP phone photos.
# MAX_PHOTO_MEGAPIXELS=100
# MAX_HEIC_MEGAPIXELS=60
# MAX_RAW_UPLOAD_MB=300
# UPLOAD_MEMORY_MB=400
# UPLOAD_USER_MB=150
# Albums with more photos than this are zipped in the background and emailed
# ZIP_BIG_PHOTOS=

# ---- Email (Amazon SES; uses the AWS keys above) ----
# EMAIL_FROM=Momento <team@example.com>
# EMAIL_REPLY_TO=team@example.com
# Where the support page's "Send us a message" form, reviews and photo reports go (default team@hexarch.org)
# The team inbox for what people send us (reviews, support messages, photo reports), e.g. the team's Gmail.
# Each email is tagged "user input" or "system" (List-Id) for Gmail labels; see services/teamMail.js.
# TEAM_EMAIL=you@gmail.com
# (SUPPORT_EMAIL, the older name, still works)

# ---- Sign-in and sign-up ----
# Google sign-in (Google Cloud Console > Credentials > OAuth client, type Web application)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# reCAPTCHA for sign-up (sign-up is closed until both are set), and the site hostnames it accepts
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# CAPTCHA_HOSTNAMES=hexarch.org,www.hexarch.org
# How many days a login lasts without being used
# TOKEN_DAYS=7
# Terms and Privacy Policy versions people must have accepted; REQUIRE_CONSENT=on asks everyone to accept them
# TOS_VERSION=2026-11-20
# PRIVACY_VERSION=2026-11-19
# REQUIRE_CONSENT=off
# REQUIRE_AGE=on makes the birth date required at sign-up (under 13s are always refused)
# REQUIRE_AGE=off

# ---- Optional features ----
# Google Maps for picking a venue (a browser key: restrict it to your site's address)
# GOOGLE_MAPS_API_KEY=
# Push notifications (make the pair once: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:team@example.com
# Nudity check engine: rekognition (default) or nsfwjs.
#   rekognition: AWS Rekognition DetectModerationLabels with the 7 levels (src/services/rekognitionService.js):
#     0-75 publish, 85-95 private (uploader may ask for a review), 100 never published.
#     Uses the AWS key above; the IAM user needs rekognition:DetectModerationLabels. About US$0.001 per photo.
#     Photo competitions' shortlists also use rekognition:DetectLabels and rekognition:DetectFaces (without them the
#     sharpest photos are shortlisted instead). Competition entries live under temp-minigames/ in the bucket while they
#     run (an S3 lifecycle rule expiring that prefix after 1 day is a good extra safety net) and the top 10 under
#     minigames-top10/.
#     Label thresholds learn from staff decisions (kept in the database). REKOGNITION_REGION defaults to AWS_REGION.
#   nsfwjs: the older free model below, on this server's CPU (blocks other requests while a photo is checked).
# NSFW_ENGINE=rekognition
# REKOGNITION_REGION=ap-southeast-2
#
# The older engine (NSFW_ENGINE=nsfwjs): one free model (NSFW.js, MobileNetV2) on this server, no GPU or other service.
# Profile photos and album covers: refused when it's NSFW_THRESHOLD (0.6) sure they're explicit (NSFW_CHECK=off: off).
# Album photos are saved privately and published only when the check is confident; the rest are declined, and the
# uploader can press "Request review", which emails STAFF_REVIEW_EMAIL and puts the photo on review.html.
# NSFW_CHECK=on
# NSFW_THRESHOLD=0.6
# Who is emailed when someone asks for a review (default team@hexarch.org)
# STAFF_REVIEW_EMAIL=team@hexarch.org
# The two thresholds (0 to 1). Risk = NSFW.js Porn + Hentai + NSFW_SEXY_WEIGHT (0.77) x Sexy.
#   risk below NSFW_RISK_BELOW: published at once
#   Porn or Hentai at NSFW_HARD_DECLINE or more: declined for good (no Request review, no email)
#   anything else: declined, with Request review for the uploader
# NSFW_RISK_BELOW=0.77
# NSFW_SEXY_WEIGHT=0.77
# NSFW_HARD_DECLINE=0.85
# It also learns: every NSFW_RELEARN_HOURS (24) staff decisions on review.html are turned into score ranges that
# publish at once too, once staff approve a range 85%+ of the time over enough reviews.
# NSFW_RELEARN_HOURS=24
# Optional fixed table file instead of the learned one (scripts/calibrateFromReviews.js, or photos you labelled
# with scripts/labelPhotos.js and scripts/calibrateModeration.js). On AWS: /opt/momento-config/calibration.json,
# read as /config/calibration.json.
# NSFW_CALIBRATION=calibration.json
# Reports from different people that hide a photo for everyone until staff decide
# REPORTS_TO_HIDE=3

# ---- The admin team (photo moderation, reports, thresholds): at most 6 people ----
# Each signs in to their own Momento account (email confirmed), then enters that email and their own 6-character code
# (letters and numbers, at least one of each, e.g. H7X2M9): unlocked for 4 hours. 5 wrong codes lock it for 15 minutes.
# Filled at start-up into EMPTY slots only (a code changed later is never put back). Either the owner alone:
# ADMIN_OWNER_EMAIL=you@example.com
# ADMIN_OWNER_CODE=H7X2M9
# ADMIN_OWNER_NAME=Your name
# or several people (slot 1-6, role owner|moderator):
# ADMIN_STAFF_JSON=[{"slot":1,"name":"…","email":"…","code":"H7X2M9","role":"owner"}]
# Afterwards owners manage the team at /api/admin/team, or: npm run admin-team -- list | add | rotate | revoke

# ---- Security alerts (both optional; always in the server log too) ----
# SECURITY_ALERT_EMAIL=
# SECURITY_ALERT_WEBHOOK=
# Spikes that raise an alert
# ALERT_401_PER_5MIN=
# ALERT_403_PER_5MIN=
# ALERT_429_PER_5MIN=
# ALERT_EXPORTS_PER_HOUR=
