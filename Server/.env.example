# Copy this file to .env and fill it in. Never commit .env.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Put the database name before the "?".
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/momento?retryWrites=true&w=majority

PORT=4000
# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
# How long a login lasts, in days
SESSION_DAYS=30
# The address this API is reached at (live: https://api.hexarch.org). Used in photo links and cookies.
PUBLIC_URL=http://localhost:4000
# Where people open the site. Leave empty locally (this server then serves the Client pages too).
# Live: FRONTEND_URL=https://hexarch.org  (and PUBLIC_URL=https://api.hexarch.org)
FRONTEND_URL=
# Sites allowed to call the API with the login cookie, comma-separated. Empty = FRONTEND_URL plus localhost:3000.
# Live: CORS_ORIGINS=https://hexarch.org,https://www.hexarch.org
CORS_ORIGINS=

# Folder with index.html and albums.html (relative to this Server folder)
CLIENT_DIR=../Client
# Where uploaded photos are written (relative to this Server folder)
UPLOAD_DIR=uploads
# Largest single photo, in megabytes
MAX_UPLOAD_MB=25

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (Apple Developer > Identifiers > Services ID). Apple only works on a real HTTPS domain.
APPLE_CLIENT_ID=

# Email through Resend (https://resend.com, free up to 3,000 a month). When both are set, Momento
# sends through Resend instead of Microsoft Graph. Resend > API Keys > Create (Sending access).
RESEND_API_KEY=
# The sender people see; its domain must be Verified in Resend > Domains
EMAIL_FROM=Momento <no-reply@hexarch.org>
# Where replies go (default: SENDER_EMAIL)
EMAIL_REPLY_TO=

# Email through Microsoft Graph (Entra ID app registration with Mail.Send application permission + admin consent)
# Entra admin center > App registrations > your app > Overview: "Directory (tenant) ID" and "Application (client) ID"
MS_TENANT_ID=
MS_CLIENT_ID=
# Certificates & secrets > Client secrets: copy the secret's Value (shown once), not its Secret ID
MS_CLIENT_SECRET=
# The mailbox emails are sent from; it must exist in the same tenant and have an Exchange Online licence
SENDER_EMAIL=

# Photos in Cloudflare R2 (free up to 10 GB). Leave empty to keep photos in UPLOAD_DIR on this machine.
# Cloudflare dashboard > R2 Object Storage: "Account ID" is on the R2 overview page
R2_ACCOUNT_ID=
# R2 > Manage API tokens > Create API token (Object Read & Write, this bucket only); both are shown once
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket's name, e.g. momento-photos (keep the bucket private)
R2_BUCKET=
