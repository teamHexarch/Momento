{
  "name": "momento-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Momento API: accounts (email, Google, Apple, email confirmation), albums, join codes and photo uploads.",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "dev:memory": "node --env-file-if-exists=.env scripts/devMemory.js",
    "email:test": "node --env-file-if-exists=.env scripts/sendTestEmail.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@azure/identity": "^4.14.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "google-auth-library": "^11.3.2",
    "jose": "^6.2.15",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
